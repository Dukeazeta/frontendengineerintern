# Copy to .env.local and fill in.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Leave as file:local.db for local development. Use your Turso URL and token in production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Optional sign-in. Each provider appears only when both values are set.
# Google callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
